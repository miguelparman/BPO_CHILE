# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server 'CL_USUARIOS' (172.17.0.162) -- Connection Manager
# 'LocalHost.CL_USUARIOS' / '162.CL_USUARIOS' en los .dtsx originales,
# autenticacion SQL Server (usuario 'mparedes'). La contrasena alli estaba
# encriptada por usuario/maquina (DPAPI) y no es reutilizable fuera de esa
# maquina: debe completarse de nuevo aqui, nunca embeberse en el codigo.
CL_USUARIOS_DB_SERVER=172.17.0.162
CL_USUARIOS_DB_NAME=CL_USUARIOS
CL_USUARIOS_DB_USER=mparedes
CL_USUARIOS_DB_PASSWORD=

# Nota: varias tareas SQL de este proceso hacen referencias cross-database de
# 3 partes contra el MISMO servidor (172.17.0.162): [SERVICIOS_GENERALES]
# (UDFs de fecha/dias habiles y limpieza XML) y [CL_DATA] (vista de usuarios).
# El usuario de arriba debe tener permiso de lectura/ejecucion sobre ambas.

# NOTA: el Connection Manager 'Externos_Frac' (223.Externos_Frac...,
# sqlclu01lis01.tchile.local) ya NO se usa para nada: como origen fue
# reemplazado por Microsoft Graph / SharePoint (ver abajo), y su unico
# destino ('CARGA DE USUARIOS RETENCIONES SERVIDOR CHILE',
# TBL_FRACTALIA_USER_RETENCIONES) se dio de baja por ser un trabajo
# obsoleto. No queda ninguna variable de entorno para esa conexion.

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph (App Registration con permiso Sites.Selected,
# concedido UNICAMENTE al sitio ReportingFractalia). Reemplaza, como ORIGEN,
# al Connection Manager OLE DB 'Externos_Frac' de los 5 .dtsx originales: el
# origen ya no es una tabla SQL Server, es el mismo archivo publicado como
# CSV en SharePoint (mismo nombre de archivo que la tabla, ver mappings.py).
# Identico patron/credenciales que 30_parque (que lee el MISMO folder).
# ---------------------------------------------------------------------------
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000

# --- SharePoint: sitio/biblioteca/carpeta donde se publican los CSV origen ---
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/13 SERVIDOR CHILE

# --- Periodo de proceso (variable de paquete User::Periodo / User::Periodo01) ---
# En los .dtsx originales era un valor LITERAL fijo escrito a mano en la
# expresion de la variable (no una formula, p.ej. '202608'): se editaba antes
# de cada corrida. Formato YYYYMM. Puede sobreescribirse puntualmente con
# --periodo en la CLI.
PERIODO=

# Tamano de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
