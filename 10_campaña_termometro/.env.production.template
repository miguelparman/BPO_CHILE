# === Conexión SQL Server ===
# Completar DB_SERVER / DB_USER / DB_PASSWORD directamente en el servidor de
# producción, nunca en un chat, un ticket, ni un repositorio de código.
DB_SERVER=
DB_DATABASE=CL_CAMPAÑAS
DB_CARTERA_DATABASE=CL_CARTERA
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# === Origen: archivos crudos en SharePoint vía Microsoft Graph ===
# Reemplaza la carpeta local sincronizada BPO - Insumos/Chile/Campanhas/Termometro.
# App Registration con acceso (Sites.Selected) al site ReportingFractalia.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/04 CAMPAÑAS/Termometro
# Rutas relativas a SHAREPOINT_FOLDER_PATH
EXCEL_CLIENTES_ARCHIVO=SOURCE/ACTUAL_.xlsx
CSV_SALESFORCE_ARCHIVO=SF/Reporte_termometros.csv
EXCEL_CLIENTES_SHEET=DB
EXCEL_DETRACTORES_SHEET=DB_DETRACTOR
CSV_SALESFORCE_ENCODING=latin-1
CSV_SALESFORCE_DELIMITER=,

# === Parámetros del proceso (normalmente se pasan por --periodo/--fecha-inicio/--fecha-fin,
# estos son solo el default si se corre main.py sin argumentos) ===
