				    Columnas = Table.SelectColumns(Tabla,{"MENSAJE_KEY", "FECHA_KEY", "HORA_LOCAL", "BANDEJA_KEY", "TIPO_KEY", "ASUNTO_AGRUPADO_KEY", "ID_MENSAJE", "CONVERSATION_ID", "ASUNTO", "CONTACTO", "FECHA_HORA_UTC", "FECHA_HORA_LOCAL", "CANTIDAD", "TABLA_ORIGEN", "PROCESO_CARGA", "ID_EJECUCION", "FECHA_CARGA", "JEFATURA_KEY", "NUMERO_CASO"})
				in
