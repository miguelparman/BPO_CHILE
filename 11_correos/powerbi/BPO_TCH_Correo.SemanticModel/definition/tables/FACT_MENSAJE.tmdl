/// Tabla de hechos: 1 fila por mensaje (gold.FACT_MENSAJE). ASUNTO y CONTACTO
/// son texto libre con datos de clientes: se usan en la vista de detalle.
table FACT_MENSAJE
	lineageTag: 4746b478-b0ba-4858-a136-235fbe343bb9

	/// Total de mensajes (entradas + salidas).
	measure Mensajes = SUM(FACT_MENSAJE[CANTIDAD])
		formatString: #,0
		displayFolder: Volumen
		lineageTag: 415a7754-76ba-4352-9bd3-7c72cf49a20a

	/// Mensajes recibidos (incluye rebotes).
	measure Entradas = CALCULATE([Mensajes], KEEPFILTERS(DIM_TIPO[TIPO] = "Entrada"))
		formatString: #,0
		displayFolder: Volumen
		lineageTag: c3fa2c5f-0c72-4332-91cb-c8cd9e0d48b6

	/// Mensajes enviados.
	measure Salidas = CALCULATE([Mensajes], KEEPFILTERS(DIM_TIPO[TIPO] = "Salida"))
		formatString: #,0
		displayFolder: Volumen
		lineageTag: 05ff31c6-0e42-4f36-96cb-a93f4923965f

	/// Notificaciones de correo no entregado (ASUNTO_AGRUPADO = REBOTE).
	measure Rebotes = CALCULATE([Mensajes], KEEPFILTERS(DIM_ASUNTO_AGRUPADO[ASUNTO_AGRUPADO] = "REBOTE"))
		formatString: #,0
		displayFolder: Volumen
		lineageTag: 4bd6de8d-7a58-4df2-bedd-07fd7a8f30b4

	/// Entradas sin contar rebotes: correos realmente recibidos de clientes.
	measure 'Entradas reales' = CALCULATE([Entradas], KEEPFILTERS(DIM_ASUNTO_AGRUPADO[ASUNTO_AGRUPADO] <> "REBOTE"))
		formatString: #,0
		displayFolder: Volumen
		lineageTag: 9031585e-1db2-4b88-a29e-80d291850787

	/// Porcentaje de las entradas que son rebotes.
	measure '% Rebote' = DIVIDE([Rebotes], [Entradas])
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: cfef6970-73cf-4960-8c9b-e9a4bfa77aa1

	/// Asesores con al menos un mensaje en el contexto filtrado.
	measure 'Asesores activos' = CALCULATE(DISTINCTCOUNT(DIM_BANDEJA[ASESOR]), FACT_MENSAJE)
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: b4c6e21e-cde9-46bf-90c6-cf03de772faf

	/// Promedio de mensajes por asesor activo.
	measure 'Mensajes por asesor (prom.)' = DIVIDE([Mensajes], [Asesores activos])
		formatString: #,0.0
		displayFolder: Indicadores
		lineageTag: ed76dde9-d7e8-43e8-ba13-84d2ca6c55ec

	/// Fecha y hora (local Peru/Bogota) de la ultima carga del ETL.
	measure 'Última carga' = MAX(FACT_MENSAJE[FECHA_CARGA])
		formatString: General Date
		displayFolder: Auditoría
		lineageTag: f814feee-afdf-4854-9dbf-de392a25f92a

	column MENSAJE_KEY
		dataType: int64
		isHidden
