# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (mismo servidor, 2 bases de datos -- Connection Managers
# 'PEOPEDESK0328.CL_TEMPORALES' y 'PEOPEDESK0328.CL_TRAFICO' del .dtsx
# original). La password estaba encriptada por usuario/maquina (DPAPI) y no
# es reutilizable: se declara aqui, nunca en el codigo.
# Las tareas SQL leen ademas, con nombres de 3 partes y en el MISMO servidor:
# CL_DATA, CL_CARTERA, CL_ANALISIS, CL_PLANTA y BBDD_GENERAL (LOGS_PROCESOS).
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME_TEMPORALES=CL_TEMPORALES
DB_NAME_TRAFICO=CL_TRAFICO
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Origen: CSV en SharePoint via Microsoft Graph ---
# Reemplaza a [Externos_Frac] (sqlclu01lis01.tchile.local) que leian los 7
# scripts Traslado_Trafico_Servidor_55_*.py. Los CSV los publica
# 01_servidor_chile (separador ';', UTF-8 con BOM). App Registration con
# permiso Sites.Selected sobre ReportingFractalia (igual que 04_usuarios_y_retenciones/08_cartera).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/13 SERVIDOR CHILE

# --- Alerta de actualizacion (enviar_alerta_trafico.py) ---
# resultado.txt que lee Power Automate (carpeta sincronizada con OneDrive).
ALERTA_TXT_PATH=D:\IRISCENE ENGINEERING CORPORATION SLU\Gestión Indicadores MDS - CL_trafico\resultado.txt
# Espera entre borrar y recrear el txt para que OneDrive detecte el borrado.
ALERTA_SEGUNDOS_ESPERA=30

# --- Periodo a procesar (variable de paquete User::Periodo) ---
# Antes estaba calculado dentro de cada script Traslado_Trafico_Servidor_55_*.py.
# PERIODO vacio = calculo automatico: si hoy es dia <= DIA_CIERRE_MES se
# procesa el mes anterior (cierre), si no el mes actual.
# PERIODO=YYYYMM (p.ej. 202608) fija el periodo para recargar un mes puntual:
# filtra los CSV (DATE_YYYYMM >= PERIODO) y es el parametro de DELETE PERIODO
# en CL_TRAFICO. Dejarlo vacio para la operacion diaria.
# Prioridad: --periodo (linea de comandos) > PERIODO (.env) > automatico.
PERIODO=
DIA_CIERRE_MES=4

# Tamano de lote de los INSERT (fast_executemany).
BATCH_SIZE=5000
