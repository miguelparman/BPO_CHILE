# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (Connection Manager 'PEOPEDESK0328.CL_TRAFICO' del .dtsx) ---
# La password estaba encriptada por usuario/maquina (DPAPI) y no es
# reutilizable: se declara aqui, nunca en el codigo.
# Log Inicio / Log Fin escriben ademas en BBDD_GENERAL.dbo.LOGS_PROCESOS
# (nombre de 3 partes, MISMO servidor).
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME_TRAFICO=CL_TRAFICO
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Periodo a procesar (variable de paquete User::Periodo, Int32) ---
# En el .dtsx era la constante 202608 (se editaba a mano). Mismo criterio que
# 12_trafico: PERIODO vacio = calculo automatico (si hoy es dia <= DIA_CIERRE_MES
# se procesa desde el mes anterior, si no desde el mes actual).
# PERIODO=YYYYMM (p.ej. 202608) recalcula desde ese mes: filtra las bases
# (AGENT_START >= PERIODO) y borra TBL_FCR con YEAR*100+MONTH >= PERIODO.
# Prioridad: --periodo (linea de comandos) > PERIODO (.env) > automatico.
PERIODO=
DIA_CIERRE_MES=4

# Tamano de lote de los INSERT (fast_executemany).
BATCH_SIZE=5000
