# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (mismo servidor, 3 bases -- Connection Managers
# '162.BBDD_GENERAL', '162.CL_CALIDAD' y '162.CL_TEMPORALES_INDICADORES' del
# .dtsx). La password estaba encriptada por usuario/maquina (DPAPI) y no es
# reutilizable: se declara aqui, nunca en el codigo.
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME_BBDD_GENERAL=BBDD_GENERAL
DB_NAME_CALIDAD=CL_CALIDAD
DB_NAME_INDICADORES=CL_TEMPORALES_INDICADORES
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Origen: CSV en SharePoint via Microsoft Graph ---
# Reemplaza a [Externos_Frac] (sqlclu01lis01.tchile.local) que leian
# Traslado_Calidad_Servidor_55_EPA_ISN.py (ENCUESTA), ..._EPA_WSP_MEDALLIA.py
# (WS_MEDALLIA_2) y enviar_alerta_encuesta.py. Los CSV los publica
# 01_servidor_chile (2 ultimos meses, separador ';', UTF-8 con BOM).
# App Registration con permiso Sites.Selected sobre ReportingFractalia.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/13 SERVIDOR CHILE
# Carpeta (misma biblioteca) donde este proceso GUARDA Encuestas_Medallia.csv
# y resultado.txt via Graph. Reemplaza a las carpetas locales
# '...\Data Analytics Reporting Fractalia - Medallia' y
# '...\Gestion Indicadores MDS - Cl_encuesta'.
SHAREPOINT_FOLDER_MEDALLIA=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/16 MEDALLIA

# --- Traslado EPA_ISN (ENCUESTA -> TBL_ENCUESTAS_CHILE) ---
# Filtro 'WHERE periodo_evento >= 202601' del script original. Los periodos
# anteriores se eliminan de la tabla; los del CSV se reemplazan; el resto
# del historico se conserva.
PERIODO_DESDE_ENCUESTA=202601

# --- Alerta de actualizacion (enviar_alerta_encuesta.py) ---
# Archivo que lee Power Automate, en SHAREPOINT_FOLDER_MEDALLIA.
ALERTA_ARCHIVO=resultado.txt
# Espera entre borrar y recrear el txt para que Power Automate detecte el borrado.
ALERTA_SEGUNDOS_ESPERA=30

# --- Portal Medallia (CL_Descarga_encuestas_Medallia.py, ahora con Playwright) ---
# Requiere una vez: python -m playwright install firefox
# Antes en texto plano dentro del script: ROTAR la password.
MEDALLIA_USER=
MEDALLIA_PASSWORD=
# Nombre del export en SHAREPOINT_FOLDER_MEDALLIA (= archivo que lee la carga).
MEDALLIA_ARCHIVO=Encuestas_Medallia.csv
# Opcionales (por defecto, los valores del script original):
# MEDALLIA_URL_LOGIN=https://telefonicacl.medallia.com/telefonicacl/
# MEDALLIA_URL_REGISTROS=https://telefonicacl.medallia.com/telefonicacl/applications/ex_WEB-9/pages/208?...
# MEDALLIA_PREFIJO_ARCHIVO=Telefonica Moviles Chile SA_export_
MEDALLIA_SEGUNDOS_ESPERA_DESCARGA=60
MEDALLIA_HEADLESS=true
# Navegador de Playwright: firefox (como el original), chromium o webkit.
MEDALLIA_NAVEGADOR=firefox

# Tamano de lote de los INSERT (fast_executemany).
BATCH_SIZE=5000
