# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server: Connection Manager OLE DB 'CL_LOGUEO' del .dtsx ---
# (172.17.0.162, catalogo CL_LOGUEO). La password estaba encriptada por
# usuario/maquina (DPAPI) y no es reutilizable: se declara aqui, nunca en el
# codigo. LOGS_PROCESOS (BBDD_GENERAL) y TBL_HISTORICO_PLACES (CL_DATA) se
# alcanzan con nombres de 3 partes desde esta misma conexion, como en SSIS.
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME=CL_LOGUEO
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Origen: CSV en SharePoint via Microsoft Graph ---
# Reemplaza al Flat File Connection Manager 'Logueo' (variable
# User::Ruta_General_Whatsapp = ruta local de ...\15 PORTAL COMERCIAL).
# El CSV lo publica 203_bot_portal_comercial (separador ';', CP1252).
# App Registration con permiso Sites.Selected sobre ReportingFractalia.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/15 PORTAL COMERCIAL
LOGUEO_ARCHIVO=REPORTE_AGENTES_FRACTALIA_SEM.csv

# --- Variable SSIS User::Periodo (formato YYYYMM) ---
# Solo la usa la tarea 'AGREGA DNI'.
# Vacio = regla del .dtsx: si hoy es dia <= 4 se toma el mes anterior; si no, el mes actual
#         (reloj de la maquina que ejecuta, como GETDATE() en la expresion SSIS).
# Con valor = periodo fijo (para reprocesar un mes concreto), p. ej. 202609
# 'python main.py --periodo YYYYMM' tiene prioridad sobre este valor.
PERIODO=

# Tamano de lote del INSERT (fast_executemany). Todo el archivo se confirma en un solo commit.
BATCH_SIZE=5000
