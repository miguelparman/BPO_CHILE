# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph -- 'BPO' (origen) y 'ReportingFractalia' (destino)
# son TENANTS DISTINTOS, cada uno con su propio App Registration (client
# credentials). Mismas credenciales que 02_ventas y 11_correos.
# Las rutas de los 4 Excel (origen y destino) estan en src/gerencia/mappings.py.
# ---------------------------------------------------------------------------

# --- 'BPO' (origen, permiso Sites.Selected sobre /sites/BPO). Drive vacio =
# drive por defecto del sitio ('Documentos compartidos'). ---
SOURCE_TENANT_ID=
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
SOURCE_GRAPH_TIMEOUT=120000
SOURCE_SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SOURCE_SHAREPOINT_SITE_PATH=/sites/BPO
SOURCE_SHAREPOINT_DRIVE_NAME=

# --- 'ReportingFractalia' (destino de la copia y origen del ETL). ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting

# ---------------------------------------------------------------------------
# SQL Server: Connection Manager OLE DB '162.CL_MOVIL' del .dtsx. Su password
# estaba encriptada por usuario/maquina (DPAPI): se declara aqui, nunca en el codigo.
# ---------------------------------------------------------------------------
DB_SERVER=172.17.0.162
DB_NAME=CL_MOVIL
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
# Tamano de lote del INSERT (fast_executemany); todo el flujo se confirma en un commit.
BATCH_SIZE=5000

# --- Validacion de conexiones antes de ejecutar: si alguna falla se espera
# ESPERA_REINTENTO_S segundos y se reintenta, hasta REINTENTOS_CONEXION veces;
# si en el ultimo reintento sigue fallando, el proceso termina (exit 1). ---
REINTENTOS_CONEXION=3
ESPERA_REINTENTO_S=300
