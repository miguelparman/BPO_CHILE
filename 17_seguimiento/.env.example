# Copiar como '.env' y completar. NO versionar '.env'.

# --- SQL Server (Connection Managers OLE DB de los .dtsx: 172.17.0.162) ---
# Todo el T-SQL usa nombres de 3 partes (CL_TEMPORALES, CL_SALESFORCE_ACTUAL,
# CL_SEGUIMIENTO_ACTUAL, BBDD_GENERAL), asi que basta una conexion.
DB_SERVER=172.17.0.162
DB_USER=
DB_PASSWORD=
DB_NAME=CL_TEMPORALES
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
# Idioma de las sesiones SSIS (el login tiene Espanol por defecto; ver config.DbSettings)
DB_LANGUAGE=us_english

# --- Origen: CSV de 201_bot_salesforce en SharePoint via Microsoft Graph ---
# App Registration con permiso Sites.Selected sobre ReportingFractalia.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
# Opcionales (por defecto, las carpetas donde publica el bot):
# SHAREPOINT_FOLDER_SEGUIMIENTO=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/01 SEGUIMIENTO
# SHAREPOINT_FOLDER_AUXILIARES=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/12 AUXILIARES

# Tamano de lote del INSERT (fast_executemany). Cada destino se confirma en un solo commit.
BATCH_SIZE=5000

# --- Validacion de conexiones: reintentos cada ESPERA_REINTENTO_S segundos ---
REINTENTOS_CONEXION=3
ESPERA_REINTENTO_S=300

# --- Frescura de los CSV (minutos). Un archivo no actualizado (mas antiguo que
# esto) o vacio no se carga: se omiten solo los bloques que lo usan y la
# corrida continua. No se espera a que el bot termine de publicar.
FRESCURA_MAX_MIN=150
