# Copiar como '.env' y completar. NO versionar '.env'.

# --- SQL Server (Connection Managers OLE DB del .dtsx: 172.17.0.162) ---
# Todo el T-SQL usa nombres de 3 partes (CL_MOVIL, CL_ANALISIS, CL_VISTAS), asi que basta una conexion.
DB_SERVER=172.17.0.162
DB_NAME=CL_MOVIL
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_LANGUAGE=us_english

# --- Origen: DB.xlsx en SharePoint via Microsoft Graph ---
# App Registration con permiso Sites.Selected sobre ReportingFractalia.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PUNTUALIDAD=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/08 PUNTUALIDAD
SHAREPOINT_FILE_SLA=DB.xlsx
SHEET_SLA=SLA - Carterizado

# Tamano de lote del INSERT (fast_executemany). TBL_SLA se confirma en un solo commit.
BATCH_SIZE=5000

# --- Casos con apertura desde esta fecha (YYYY-MM-DD). El .dtsx la tenia fija en 2025-08-01. ---
FECHA_DESDE=2025-08-01

# --- Validacion de conexiones: reintentos cada ESPERA_REINTENTO_S segundos ---
REINTENTOS_CONEXION=3
ESPERA_REINTENTO_S=300
