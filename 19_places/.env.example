# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- Microsoft Entra ID / Graph: sitio 'ReportingFractalia' (App Registration, client credentials).
# Mismas credenciales que 16_Gerencia, 02_ventas y 11_correos. El Excel esta en
# <drive>/REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/05 CARTERA/Place utilizados.xlsx (ver mappings.py).
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting

# --- SQL Server: Connection Manager OLE DB '162.CL_DATA' del .dtsx (172.17.0.162, usuario mparedes).
# Su password estaba encriptada por usuario/maquina (DPAPI): se declara aqui, nunca en el codigo.
DB_SERVER=172.17.0.162
DB_NAME=CL_DATA
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
BATCH_SIZE=5000

# --- Validacion de conexiones antes de ejecutar: si alguna falla se espera ESPERA_REINTENTO_S
# segundos y se reintenta hasta REINTENTOS_CONEXION veces; si sigue fallando, termina (exit 1).
REINTENTOS_CONEXION=3
ESPERA_REINTENTO_S=300
