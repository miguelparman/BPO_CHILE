# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# ---------------------------------------------------------------------------
# Power BI Service -- App Registration de Repositorio.bi@fractaliasystems.es
# (client credentials, app-only). Requisitos en Power BI:
#   - Portal de administracion > Configuracion del inquilino: "Las entidades de
#     servicio pueden usar las API de Fabric" habilitado (para la app o su grupo).
#   - La app agregada como Miembro/Administrador (o Colaborador) de cada
#     workspace a leer. 'Mi area de trabajo' no es accesible por una app.
# ---------------------------------------------------------------------------
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_TIMEOUT_S=120

# Workspaces a leer, por nombre o id, separados por coma. Vacio = todos los
# visibles para la app. '--workspace' en la linea de comandos tiene prioridad.
PBI_WORKSPACES=BPO_TCH

# Cantidad de actualizaciones a pedir por dataset (la API guarda un historial
# limitado; el CSV historico de salida/ acumula lo que se vaya leyendo).
PBI_TOP_ACTUALIZACIONES=100

# Zona horaria de referencia: columnas *_LOCAL y analisis de cruces. Cada
# programacion de Power BI puede estar en otra zona; se convierten todas a esta.
ZONA_HORARIA=America/Lima

# Dias de historial que se usan para duraciones, cruces y concurrencia.
DIAS_ANALISIS=60

# Carpeta de salida (Excel + CSV historico). Vacio = salida/ junto a main.py.
SALIDA_DIR=

# --- Validacion de conexiones antes de ejecutar: si falla se espera
# ESPERA_REINTENTO_S segundos y se reintenta, hasta REINTENTOS_CONEXION veces. ---
REINTENTOS_CONEXION=3
ESPERA_REINTENTO_S=300
